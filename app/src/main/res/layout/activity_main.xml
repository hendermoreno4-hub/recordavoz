<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="160dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recordá Voz"
                android:textColor="@color/ink"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Dime qué recordarte y cada cuánto"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <!-- Aviso amarillo cuando un recordatorio sonó con la app abierta -->
            <LinearLayout
                android:id="@+id/dueBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_alert"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/dueText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/accentInk"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/dueOk"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_primary"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:stateListAnimator="@null"
                    android:text="Listo"
                    android:textAllCaps="false"
                    android:textColor="@color/inkOnInk" />
            </LinearLayout>

            <!-- Avisos de permisos (se llenan desde el código) -->
            <LinearLayout
                android:id="@+id/banners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Nuevo recordatorio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Label"
                    android:text="NUEVO RECORDATORIO" />

                <TextView
                    android:id="@+id/live"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Toca el micrófono y di, por ejemplo: «recuérdame tomar agua cada 2 horas»."
                    android:textColor="@color/muted"
                    android:textSize="14sp"
                    android:textStyle="italic" />

                <EditText
                    android:id="@+id/text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:gravity="top"
                    android:hint="O escríbelo aquí"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2"
                    android:padding="12dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted"
                    android:textSize="16sp" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="14dp"
                    android:text="RECORDARME CADA" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/save"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_primary"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:stateListAnimator="@null"
                        android:text="Guardar"
                        android:textAllCaps="false"
                        android:textColor="@color/inkOnInk"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/clear"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_ghost"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:stateListAnimator="@null"
                        android:text="Borrar"
                        android:textAllCaps="false"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Lista -->
            <TextView
                style="@style/Label"
                android:layout_marginTop="22dp"
                android:text="TUS RECORDATORIOS" />

            <LinearLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- Ajustes -->
            <TextView
                style="@style/Label"
                android:layout_marginTop="22dp"
                android:text="AJUSTES" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <CheckBox
                    android:id="@+id/optSpeak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Leer el recordatorio en voz alta"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No molestar"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/quietFrom"
                        style="@style/SmallButton" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:text="a"
                        android:textColor="@color/muted" />

                    <Button
                        android:id="@+id/quietTo"
                        style="@style/SmallButton" />
                </LinearLayout>

                <Button
                    android:id="@+id/test"
                    style="@style/SmallButton"
                    android:layout_marginTop="14dp"
                    android:text="Probar aviso" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Todo se guarda solo en este teléfono."
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Botón grande de micrófono -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_dock"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="18dp">

        <ImageButton
            android:id="@+id/mic"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_mic"
            android:contentDescription="Hablar"
            android:elevation="6dp"
            android:src="@drawable/ic_mic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Toca para hablar"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
